{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/web/**/*.js",
    "src/emulator/*.js",
    "packages/*/src/**/*.js",
    "apps/**/*.js",
    "tools/*.js",
    "types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "build",
    "src/emulator/zx81"
  ]
}
